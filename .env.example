# Copy to .env before running docker-compose. .env itself is gitignored --
# these are the keys docker-compose.yml expects, with throwaway values.

# PostgreSQL - inventory-db (hosts movies_db)
INVENTORY_DB_NAME=movies_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=change_me

# PostgreSQL - billing-db (hosts billing_db)
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=change_me

# RabbitMQ. Not `guest`: RabbitMQ only accepts that account over loopback,
# and every client here connects across the crud-net bridge network.
RABBITMQ_USER=billing_mq
RABBITMQ_PASSWORD=change_me
BILLING_QUEUE=billing_queue
